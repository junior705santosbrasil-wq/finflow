# Porta do servidor
PORT=3000

# URL de conexão do PostgreSQL (obrigatória em produção)
# Ex: postgres://usuario:senha@host:5432/banco
DATABASE_URL=postgres://...@.../...

# Para bancos locais sem SSL, use DATABASE_SSL=false
#DATABASE_SSL=false

# Segredo para assinar os tokens (troque por um valor aleatório e longo)
JWT_SECRET=altere_este_segredo_por_um_valor_longo_e_aleatorio

# Tempo de expiração do login (ex.: 7d, 1d, 30d)
JWT_EXPIRES=7d
